<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.floatingtoolbar.FloatingToolbarLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:visibility="gone"
    android:layout_marginEnd="8dp"
    android:elevation="8dp"
    app:marginRightSystemWindowInsets="true"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp"
    android:orientation="horizontal"
    app:marginBottomSystemWindowInsets="true"
    android:layout_marginStart="8dp"
    android:layout_gravity="bottom|center_horizontal"
    android:gravity="center_vertical"
    android:background="?colorSurface"
    app:marginLeftSystemWindowInsets="true"
    app:marginTopSystemWindowInsets="false"
    android:id="@+id/selectionPanel">

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_height="48dp"
            android:layout_width="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_height="48dp"
                android:layout_width="48dp"
                android:padding="14dp"
                android:src="@drawable/ic_close"
                android:scaleType="fitCenter"
                android:tint="?colorOnSurface"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fm_action_clear_selection"
                android:id="@+id/btn_close" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="left"
                android:textSize="15sp"
                android:textColor="?colorOnSurface"
                android:id="@+id/txt_selected_count"
                android:text="0"
                android:textStyle="bold" />

            <ImageView
                android:layout_height="48dp"
                android:layout_width="48dp"
                android:padding="13dp"
                android:src="@drawable/outline_select_all"
                android:scaleType="fitCenter"
                android:tint="?colorOnSurface"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fm_action_select_all"
                android:id="@+id/btn_selectall" />

        </LinearLayout>

        <LinearLayout
            android:layout_height="48dp"
            android:layout_width="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:layout_height="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:padding="13dp"
                android:src="@drawable/ic_copy"
                android:scaleType="fitCenter"
                android:tint="?colorOnSurface"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fm_action_copy"
                android:id="@+id/btn_copy" />

            <ImageView
                android:layout_height="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:padding="13dp"
                android:src="@drawable/ic_cut"
                android:scaleType="fitCenter"
                android:tint="?colorOnSurface"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fm_action_cut"
                android:id="@+id/btn_cut" />

            <ImageView
                android:layout_height="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:padding="13dp"
                android:src="@drawable/ic_paste"
                android:scaleType="fitCenter"
                android:tint="?colorOnSurface"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fm_action_paste"
                android:id="@+id/btn_paste" />

            <ImageView
                android:layout_height="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:padding="13dp"
                android:src="@drawable/ic_delete"
                android:scaleType="fitCenter"
                android:tint="?colorError"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:id="@+id/btn_delete" />

            <ImageView
                android:layout_height="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:padding="13dp"
                android:src="@drawable/more_vert"
                android:scaleType="fitCenter"
                android:tint="?colorOnSurface"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fm_item_actions"
                android:id="@+id/selectionmore" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.floatingtoolbar.FloatingToolbarLayout>
