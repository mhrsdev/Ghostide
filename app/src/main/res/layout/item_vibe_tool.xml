<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="3dp"
    android:paddingEnd="16dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/toolCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/toolSpinner"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorSize="18dp"
                app:trackThickness="2dp" />

            <ImageView
                android:id="@+id/toolStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_vibe_code" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/toolHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/toolName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textDirection="ltr" />

                <TextView
                    android:id="@+id/toolTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:alpha="0.7"
                    android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textDirection="ltr" />
            </LinearLayout>

            <TextView
                android:id="@+id/toolPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textDirection="ltr" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
