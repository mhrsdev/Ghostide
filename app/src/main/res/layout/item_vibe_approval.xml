<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/approvalCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/approvalHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/approvalIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_vibe_shield" />

            <TextView
                android:id="@+id/approvalTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall" />
        </LinearLayout>

        <TextView
            android:id="@+id/approvalDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.85"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textDirection="firstStrong" />

        <HorizontalScrollView
            android:id="@+id/approvalCommandScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/approvalCommand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="left"
                android:maxLines="8"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:textDirection="ltr"
                android:textIsSelectable="false"
                android:textSize="13sp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/approvalActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/approvalAllow"
                style="@style/Widget.GhostIDE.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/vibe_approval_allow_once" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/approvalDeny"
                style="@style/Widget.GhostIDE.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/vibe_approval_deny" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/approvalMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/approvalSession"
                style="@style/Widget.GhostIDE.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/vibe_approval_allow_session"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/approvalAlways"
                style="@style/Widget.GhostIDE.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/vibe_approval_allow_always"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/approvalResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="?attr/textAppearanceLabelLarge" />
    </LinearLayout>
</FrameLayout>
