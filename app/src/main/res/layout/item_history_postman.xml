<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.listitem.ListItemLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/ThemeOverlay.Ghost.FileRow">

    <com.google.android.material.listitem.ListItemCardView
        android:id="@+id/rowCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:contentPaddingBottom="0dp"
        app:contentPaddingLeft="0dp"
        app:contentPaddingRight="0dp"
        app:contentPaddingTop="0dp">

        <LinearLayout
            android:id="@+id/rowContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="2dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/methodBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_rounded"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="@dimen/postman_badge_min_width"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="POST" />

            <LinearLayout
                android:id="@+id/textColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/urlText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:textSize="13sp"
                    tools:text="https://api.example.com/v1/users/me" />

                <LinearLayout
                    android:id="@+id/metaRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/statusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_rounded"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="1dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="200" />

                    <TextView
                        android:id="@+id/metaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:alpha="0.7"
                        android:maxLines="1"
                        android:textSize="12sp"
                        tools:text="128 ms · 2 min ago" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/deleteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_delete"
                android:padding="13dp"
                android:src="@drawable/ic_delete" />
        </LinearLayout>
    </com.google.android.material.listitem.ListItemCardView>
</com.google.android.material.listitem.ListItemLayout>
