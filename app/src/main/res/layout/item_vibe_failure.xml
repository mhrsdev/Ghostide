<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/failureCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/failureHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/failureIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_vibe_warning" />

            <TextView
                android:id="@+id/failureTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall" />
        </LinearLayout>

        <TextView
            android:id="@+id/failureBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textDirection="firstStrong" />

        <TextView
            android:id="@+id/failureDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:fontFamily="monospace"
            android:maxLines="6"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textDirection="ltr"
            android:textIsSelectable="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/failureRetry"
            style="@style/Widget.GhostIDE.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/vibe_retry"
            app:icon="@drawable/ic_refresh" />
    </LinearLayout>
</FrameLayout>
