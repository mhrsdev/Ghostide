<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/initOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLowest"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ir.hanzodev1375.components.glsl.GLSLShaderView
        android:id="@+id/initOverlayShader"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:orientation="vertical">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/atomicghost"
            android:scaleType="fitCenter"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/terminal_setup_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/initOverlayVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.6"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginBottom="28dp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/initOverlayProgress"
            style="@style/Widget.GhostIDE.InstallProgress.Circular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/initOverlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.72"
            android:gravity="center"
            android:text="@string/terminal_setup_status"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

    </LinearLayout>

</FrameLayout>
