<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:backgroundTint="?attr/colorSurfaceContainer"
    android:id="@+id/coordinator">

    <ir.hanzodev1375.components.childern.ViewChilder
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="visible"
        android:id="@+id/backgroundIconTerminal" />

    <LinearLayout
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:id="@+id/mainContent">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:background="?attr/colorSurfaceContainer"
            android:minHeight="56dp"
            android:title="@string/terminal_title"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium"
            app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
            app:contentInsetStartWithNavigation="0dp"
            android:id="@+id/toolbar">

            <ImageButton
                android:layout_height="48dp"
                android:layout_width="48dp"
                android:contentDescription="@string/terminal_more_options"
                android:src="@drawable/more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="4dp"
                app:tint="?attr/colorOnSurface"
                android:id="@+id/btnMoreMenu" />

        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:id="@+id/tabsBar"
            android:layout_height="48dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorSurfaceContainer">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_height="48dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                app:tabMode="scrollable"
                app:tabGravity="start"
                android:background="@android:color/transparent"
                app:tabIndicator="@drawable/bg_terminal_tab_indicator"
                app:tabIndicatorHeight="3dp"
                app:tabIndicatorFullWidth="false"
                app:tabPaddingStart="12dp"
                app:tabPaddingEnd="12dp"
                app:tabContentStart="4dp"
                app:tabMaxWidth="200dp"
                app:tabMinWidth="72dp" />

            <ImageButton
                android:layout_height="48dp"
                android:layout_width="48dp"
                android:contentDescription="@string/terminal_new_session"
                android:src="@drawable/ic_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:tint="?attr/colorOnSurface"
                android:layout_marginEnd="4dp"
                android:id="@+id/btnNewSession" />

        </LinearLayout>

        <View
            android:layout_height="1dp"
            android:layout_width="match_parent"
            android:background="?attr/colorOutlineVariant"
            android:id="@+id/dividerTop" />

        <LinearLayout
            android:id="@+id/installBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="?attr/colorSurfaceContainerHigh"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:id="@+id/installBannerRow">

                <ImageView
                    android:id="@+id/installBannerIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_download" />

                <LinearLayout
                    android:id="@+id/installBannerTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/installBannerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/installBannerStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.72"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:maxLines="3"
                        android:ellipsize="end" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/installBannerAction"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <ImageButton
                    android:id="@+id/installBannerDismiss"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_action_dismiss"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />

            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/installBannerProgress"
                style="@style/Widget.GhostIDE.InstallProgress.Linear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:max="100" />

        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layoutDirection="ltr"
            android:id="@+id/viewPager" />

        <FrameLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:background="@drawable/bg_input_dock"
            android:id="@+id/inputDock">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:id="@+id/inputDockContent">

                <LinearLayout
                    android:layout_height="48dp"
                    android:layout_width="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/terminal_toggle_dock"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/dragHandle">

                    <View
                        android:layout_height="4dp"
                        android:layout_width="32dp"
                        android:background="@drawable/bg_drag_handle"
                        android:id="@+id/dragHandlePill" />

                    <ImageView
                        android:layout_height="18dp"
                        android:layout_width="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand"
                        android:layout_marginStart="8dp"
                        android:id="@+id/handleChevron" />

                </LinearLayout>

                <FrameLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="4dp"
                    android:id="@+id/dockPages">

                    <HorizontalScrollView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:scrollbars="none"
                        android:background="@android:color/transparent"
                        android:layoutDirection="ltr"
                        android:minHeight="48dp"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/extraKeysScroll">

                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:paddingEnd="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp">

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:id="@+id/keyEsc"
                                android:text="ESC" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:id="@+id/keyTab"
                                android:text="TAB" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:checkable="true"
                                android:id="@+id/keyCtrl"
                                android:text="CTRL" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:checkable="true"
                                android:id="@+id/keyAlt"
                                android:text="ALT" />

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:contentDescription="@string/terminal_key_up"
                                android:id="@+id/keyUp"
                                android:text="↑" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:contentDescription="@string/terminal_key_down"
                                android:id="@+id/keyDown"
                                android:text="↓" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:contentDescription="@string/terminal_key_left"
                                android:id="@+id/keyLeft"
                                android:text="←" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:contentDescription="@string/terminal_key_right"
                                android:id="@+id/keyRight"
                                android:text="→" />

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:id="@+id/keyHome"
                                android:text="HOME" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:id="@+id/keyEnd"
                                android:text="END" />

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:id="@+id/keySlash"
                                android:text="/" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:id="@+id/keyDash"
                                android:text="-" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:id="@+id/keyPipe"
                                android:text="|" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:id="@+id/keyTilde"
                                android:text="~" />

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.GhostIDE.TerminalKey"
                                android:contentDescription="@string/terminal_paste"
                                app:icon="@drawable/outline_content_paste"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="20dp"
                                android:id="@+id/keyPaste" />

                        </LinearLayout>

                    </HorizontalScrollView>

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:visibility="invisible"
                        android:paddingEnd="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="4dp"
                        android:paddingStart="12dp"
                        android:id="@+id/commandInputRow"
                        android:paddingTop="2dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            style="@style/Widget.GhostIDE.TextInputLayout.Dense"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_send"
                            app:endIconContentDescription="@string/terminal_send_command"
                            app:endIconTint="?attr/colorPrimary"
                            android:layout_weight="1"
                            android:id="@+id/commandInputLayout">

                            <EditText
                                android:layout_height="wrap_content"
                                android:layout_width="match_parent"
                                android:minHeight="48dp"
                                android:imeOptions="actionSend|flagNoFullscreen"
                                android:importantForAutofill="no"
                                android:textSize="14sp"
                                android:fontFamily="monospace"
                                android:textDirection="ltr"
                                android:textAlignment="viewStart"
                                android:hint="@string/terminal_command_hint"
                                android:maxLines="4"
                                android:inputType="text|textNoSuggestions"
                                android:id="@+id/commandInput" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <include
        layout="@layout/init_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
