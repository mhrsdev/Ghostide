<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/coordinator"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:backgroundTint="?colorSurfaceContainer">

  <ir.hanzodev1375.components.childern.ViewChilder
    android:id="@+id/backgroundIconPlugins"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/pluginContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/headtop"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?colorSurfaceContainer"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="4dp"
      android:paddingEnd="16dp"
      android:paddingBottom="6dp">

      <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/plugin_manager_back"
        android:src="@drawable/ic_back"
        android:tint="?colorOnSurface" />

      <LinearLayout
        android:id="@+id/titleColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/titleText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:ellipsize="end"
          android:text="@string/plugin_manager_title"
          android:textSize="20sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/subtitleText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:alpha="0.7"
          android:maxLines="1"
          android:ellipsize="end"
          android:textSize="13sp" />

      </LinearLayout>

    </LinearLayout>

    <ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat
      android:id="@+id/masterCard"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_marginTop="8dp"
      android:layout_marginEnd="12dp"
      app:adaptiveTint="true"
      app:bevelWidth="12dp"
      app:cornerRadius="20dp"
      app:dispersionStrength="0.1"
      app:glassMaterial="regular"
      app:refractionHeight="48dp"
      app:sensorHighlight="false">

      <LinearLayout
        android:id="@+id/masterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <FrameLayout
          android:id="@+id/masterIconTile"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:layout_marginEnd="12dp">

          <ImageView
            android:id="@+id/masterIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_outline_extension" />

        </FrameLayout>

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/masterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plugin_manager_master_title"
            android:textSize="16sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/masterState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:alpha="0.75"
            android:textSize="13sp" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/masterSwitch"
          android:layout_width="wrap_content"
          android:layout_height="48dp"
          android:layout_marginStart="8dp"
          android:contentDescription="@string/plugin_manager_master_switch_desc"
          android:minWidth="48dp" />

      </LinearLayout>

    </ir.hanzodev1375.components.sheet.customitemsheet.ui.GlassCompat>

    <ir.hanzodev1375.components.SearchLayout
      android:id="@+id/searchLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_marginTop="8dp"
      android:layout_marginEnd="12dp" />

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="8dp"
      android:layout_weight="1">

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlugins"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

      <LinearLayout
        android:id="@+id/stateBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="28dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
          android:id="@+id/stateProgress"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:layout_marginBottom="12dp"
          android:indeterminate="true"
          android:visibility="gone" />

        <ImageView
          android:id="@+id/stateIcon"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:layout_marginBottom="12dp"
          android:alpha="0.8"
          android:contentDescription="@null"
          android:src="@drawable/ic_outline_extension" />

        <TextView
          android:id="@+id/stateTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="17sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/emptyText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:alpha="0.72"
          android:text="@string/plugin_manager_empty"
          android:textSize="14sp" />

      </LinearLayout>

    </FrameLayout>

  </LinearLayout>

  <ir.hanzodev1375.components.sheet.customitemsheet.ui.FabGlass
    android:id="@+id/fab"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:layout_gravity="bottom|end"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="16dp"
    android:contentDescription="@string/plugin_manager_add"
    android:src="@drawable/ic_add"
    app:adaptiveTint="true"
    app:bevelWidth="12dp"
    app:cornerRadius="16dp"
    app:dispersionStrength="0.12"
    app:glassMaterial="regular"
    app:refractionHeight="52dp"
    app:sensorHighlight="false" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
