<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/featuresColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_features_header"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:alpha="0.7"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/onboarding_features_desc"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/tvFeatureLsp"
            style="@style/OnboardingFeatureRow"
            android:text="@string/onboarding_features_lsp" />

        <TextView
            android:id="@+id/tvFeatureTerminal"
            style="@style/OnboardingFeatureRow"
            android:text="@string/onboarding_features_terminal" />

        <TextView
            android:id="@+id/tvFeatureGit"
            style="@style/OnboardingFeatureRow"
            android:text="@string/onboarding_features_git" />

        <TextView
            android:id="@+id/tvFeaturePlugins"
            style="@style/OnboardingFeatureRow"
            android:text="@string/onboarding_features_plugins" />

        <TextView
            android:id="@+id/tvFeatureThemes"
            style="@style/OnboardingFeatureRow"
            android:text="@string/onboarding_features_themes" />

        <TextView
            android:id="@+id/tvFeatureRemote"
            style="@style/OnboardingFeatureRow"
            android:text="@string/onboarding_features_remote" />

    </LinearLayout>

</ScrollView>
